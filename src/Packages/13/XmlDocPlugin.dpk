package XmlDocPlugin;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'XmlDoc Plugin - XML Documentation WYSIWYG Editor'}
{$LIBSUFFIX AUTO}
{$DESIGNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  designide,
  xmlrtl,
  vclwinx,
  vcledge,
  VclSmp;

contains
  XmlDoc.AI.Contracts in '..\..\Core\XmlDoc.AI.Contracts.pas',
  XmlDoc.AI.Context in '..\..\Core\XmlDoc.AI.Context.pas',
  XmlDoc.AI.Prompts in '..\..\Core\XmlDoc.AI.Prompts.pas',
  XmlDoc.AI.OpenAI in '..\..\Core\XmlDoc.AI.OpenAI.pas',
  XmlDoc.AI.Transport in '..\..\Core\XmlDoc.AI.Transport.pas',
  XmlDoc.Plugin.AISettings in '..\..\Plugin\XmlDoc.Plugin.AISettings.pas',
  XmlDoc.Plugin.AIAssistant in '..\..\Plugin\XmlDoc.Plugin.AIAssistant.pas',
  XmlDoc.SourceAccess in '..\..\Core\XmlDoc.SourceAccess.pas',
  XmlDoc.HelpGen.Renderer.HMXP in '..\..\HelpGen\XmlDoc.HelpGen.Renderer.HMXP.pas',
  XmlDoc.Plugin.Browser in '..\..\Plugin\XmlDoc.Plugin.Browser.pas',
  XmlDoc.Consts in '..\..\Core\XmlDoc.Consts.pas',
  XmlDoc.Model in '..\..\Core\XmlDoc.Model.pas',
  XmlDoc.CodeGen in '..\..\Core\XmlDoc.CodeGen.pas',
  XmlDoc.CodeGen.OTA in '..\..\Core\XmlDoc.CodeGen.OTA.pas',
  XmlDoc.HelpGen.Resources in '..\..\HelpGen\XmlDoc.HelpGen.Resources.pas',
  XmlDoc.HelpGen.Inheritance in '..\..\HelpGen\XmlDoc.HelpGen.Inheritance.pas',
  XmlDoc.XmlFragments in '..\..\Core\XmlDoc.XmlFragments.pas',
  XmlDoc.ShortcutValidation in '..\..\Core\XmlDoc.ShortcutValidation.pas',
  XmlDoc.SourceText in '..\..\Core\XmlDoc.SourceText.pas',
  XmlDoc.Markup in '..\..\Core\XmlDoc.Markup.pas',
  XmlDoc.ProjectContext in '..\..\Core\XmlDoc.ProjectContext.pas',
  XmlDoc.Documentation in '..\..\Core\XmlDoc.Documentation.pas',
  XmlDoc.ProjectIndex in '..\..\Core\XmlDoc.ProjectIndex.pas',
  XmlDoc.Expressions in '..\..\Core\XmlDoc.Expressions.pas',
  XmlDoc.Parser in '..\..\Core\XmlDoc.Parser.pas',
  XmlDoc.StubGen in '..\..\Core\XmlDoc.StubGen.pas',
  XmlDoc.Plugin.Localization in '..\..\Plugin\XmlDoc.Plugin.Localization.pas',
  XmlDoc.I18n in '..\..\Core\XmlDoc.I18n.pas',
  XmlDoc.Logger in '..\..\Core\XmlDoc.Logger.pas',
  XmlDoc.ErrorHandler in '..\..\Core\XmlDoc.ErrorHandler.pas',
  XmlDoc.ParamDict in '..\..\Core\XmlDoc.ParamDict.pas',
  XmlDoc.HelpGen.Types in '..\..\HelpGen\XmlDoc.HelpGen.Types.pas',
  XmlDoc.HelpGen.Scanner in '..\..\HelpGen\XmlDoc.HelpGen.Scanner.pas',
  XmlDoc.HelpGen.BatchParser in '..\..\HelpGen\XmlDoc.HelpGen.BatchParser.pas',
  XmlDoc.HelpGen.CrossRef in '..\..\HelpGen\XmlDoc.HelpGen.CrossRef.pas',
  XmlDoc.HelpGen.Navigation in '..\..\HelpGen\XmlDoc.HelpGen.Navigation.pas',
  XmlDoc.HelpGen.Renderer in '..\..\HelpGen\XmlDoc.HelpGen.Renderer.pas',
  XmlDoc.HelpGen.Renderer.HTML in '..\..\HelpGen\XmlDoc.HelpGen.Renderer.HTML.pas',
  XmlDoc.HelpGen.Renderer.MD in '..\..\HelpGen\XmlDoc.HelpGen.Renderer.MD.pas',
  XmlDoc.HelpGen.Renderer.CHM in '..\..\HelpGen\XmlDoc.HelpGen.Renderer.CHM.pas',
  XmlDoc.HelpGen.Renderer.JSON in '..\..\HelpGen\XmlDoc.HelpGen.Renderer.JSON.pas',
  XmlDoc.HelpGen.SitePublisher in '..\..\HelpGen\XmlDoc.HelpGen.SitePublisher.pas',
  XmlDoc.HelpGen.Coverage in '..\..\HelpGen\XmlDoc.HelpGen.Coverage.pas',
  XmlDoc.HelpGen.ThemeEngine in '..\..\HelpGen\XmlDoc.HelpGen.ThemeEngine.pas',
  XmlDoc.Plugin.Main in '..\..\PlugIn\XmlDoc.Plugin.Main.pas',
  XmlDoc.Plugin.EditorNotifier in '..\..\PlugIn\XmlDoc.Plugin.EditorNotifier.pas',
  XmlDoc.Plugin.DocInspector in '..\..\PlugIn\XmlDoc.Plugin.DocInspector.pas',
  XmlDoc.Plugin.Settings in '..\..\PlugIn\XmlDoc.Plugin.Settings.pas',
  XmlDoc.Plugin.Shortcuts in '..\..\PlugIn\XmlDoc.Plugin.Shortcuts.pas',
  XmlDoc.Plugin.BatchGenDialog in '..\..\PlugIn\XmlDoc.Plugin.BatchGenDialog.pas',
  XmlDoc.Plugin.CoverageDialog in '..\..\PlugIn\XmlDoc.Plugin.CoverageDialog.pas',
  XmlDoc.Plugin.QuickDocPreview in '..\..\PlugIn\XmlDoc.Plugin.QuickDocPreview.pas',
  XmlDoc.Plugin.UndocNavigator in '..\..\PlugIn\XmlDoc.Plugin.UndocNavigator.pas',
  XmlDoc.Plugin.SettingsDialog in '..\..\PlugIn\XmlDoc.Plugin.SettingsDialog.pas',
  XmlDoc.Plugin.UpdateChecker in '..\..\PlugIn\XmlDoc.Plugin.UpdateChecker.pas',
  XmlDoc.Plugin.AboutDialog in '..\..\Plugin\XmlDoc.Plugin.AboutDialog.pas',
  XmlDoc.Plugin.ProjectDocumentation in '..\..\Plugin\XmlDoc.Plugin.ProjectDocumentation.pas',
  XmlDoc.Plugin.EditSession in '..\..\Plugin\XmlDoc.Plugin.EditSession.pas',
  XmlDoc.Plugin.DeclarationContext in '..\..\Plugin\XmlDoc.Plugin.DeclarationContext.pas',
  XmlDoc.Plugin.DocExplorer in '..\..\Plugin\XmlDoc.Plugin.DocExplorer.pas',
  XmlDoc.Plugin.Utils in '..\..\Plugin\XmlDoc.Plugin.Utils.pas';

end.
